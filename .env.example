# 复制本文件为 .env 并按实际环境修改；.env 已在 .gitignore 中，不会被提交
# MySQL 数据库连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请填写你的数据库密码
MYSQL_DATABASE=ebusiness
MYSQL_CHARSET=utf8mb4

# Chrome 远程调试地址（先以 --remote-debugging-port=9222 启动 Chrome）
CHROME_DEBUG_ADDRESS=127.0.0.1:9222

# stealth.min.js 路径（反自动化检测脚本，可选；不配置则默认放项目根目录）
# STEALTH_JS_PATH=./stealth.min.js

# 运行期数据目录（CSV / 图片 / 视频 / 日志），默认为项目下的 data 目录
# DATA_DIR=./data
